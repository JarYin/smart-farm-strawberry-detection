# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ (ไฟล์ .env ถูกกันไว้ใน .gitignore แล้ว
# จะไม่ถูกเก็บเข้า git) ห้ามใส่คีย์จริงลงในไฟล์นี้ (.env.example) เพราะไฟล์นี้ถูกเก็บเข้า git

# API key ของ Roboflow — เอาได้จาก roboflow.com > Settings > Roboflow API > Private API Key
# ใช้กับ model.backend: roboflow ใน config.yaml และ tools/roboflow_infer.py
ROBOFLOW_API_KEY=your_roboflow_private_api_key_here
